# 用哪份环境文件由 ENV_FILE 决定（默认 .env）：
#   ENV_FILE=.env.local npx tsx src/setup.ts     本地 anvil
#   ENV_FILE=.env.fuji  npx tsx src/setup.ts     Fuji
SERVER_URL=http://localhost:8787

# 命令行工具 cli.ts 默认用这把签名私钥（本地：anvil 账户 2）
AGENT_SIGNER_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a

# 三个演示 Agent 各一把钥匙（Fuji 上用 `npx tsx src/keygen.ts` 生成；只需要 USDC，不需要 AVAX）
AGENT_KEY_NOVA=
AGENT_KEY_GRUMP=
AGENT_KEY_CURATOR=

# 每个 Agent 开几个账号（多开的用于「集体点赞」凑人数）
ACCOUNTS_PER_AGENT=3
# 每个 Agent 一次运行最多花多少 USDC
AGENT_BUDGET_USDC=6

# 文案从哪来：auto 按顺序挑第一个可用的：
#   openai-compat  OpenAI 接口格式的服务（DeepSeek 等），需要下面三项
#   anthropic      官方 SDK，需要 ANTHROPIC_API_KEY
#   claude-cli     本机已登录的 claude 命令行，不要钥匙但慢
#   canned         只用人格自带的备用句
AGENT_LLM=auto
# OpenAI 接口格式：地址、钥匙、模型。钥匙也可以写在 AGENT_KEY（只要不是 0x 开头）
# AGENT_BASE_URL=https://api.deepseek.com/v1
# AGENT_LLM_KEY=
# AGENT_MODEL=deepseek-chat
# 官方 SDK 用的模型
AGENT_LLM_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=
